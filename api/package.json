{
  "name": "async-ricochet-robots-api",
  "version": "1.0.0",
  "description": "Azure Functions API for Async Ricochet Robots",
  "main": "dist/src/index.js",
  "scripts": {
    "copy:shared": "copyfiles -u 2 \"../shared/**/*.ts\" lib-shared",
    "clean:shared": "rimraf lib-shared",
    "prebuild": "npm run copy:shared",
    "build": "tsc && copyfiles host.json dist",
    "watch": "npm run copy:shared && tsc --watch",
    "clean": "npm run clean:shared && rimraf dist",
    "prestart": "npm run build",
    "start": "func start",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "azure-functions",
    "ricochet-robots"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.1",
    "@azure/functions": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.23",
    "azurite": "^3.35.0",
    "copyfiles": "^2.4.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  }
}
